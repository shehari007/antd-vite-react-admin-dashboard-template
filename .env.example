# Copy this file to .env and edit the values. Never commit your real .env.
#
# Every variable exposed to the browser must start with VITE_. Anything without
# that prefix stays server side and is not readable from the app, which is why
# secrets like private API keys do not belong in this file at all.

# Base URL for your backend. The mock services in src/services/ ignore it until
# you swap them for real fetch calls, so it is safe to leave as is at first.
VITE_API_BASE_URL=https://api.example.com

# Optional. Overrides the version shown in the footer. When it is not set the
# app falls back to the "version" field in package.json.
VITE_APP_VERSION=

# Set to "true" to require sign in before any /dashboard route renders. Leave it
# unset or "false" while you are sharing a public preview.
VITE_REQUIRE_AUTH=false
